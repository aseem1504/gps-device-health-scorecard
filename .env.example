# Only needed if you want to point the ORIGINAL notebooks (notebooks/original) at your own systems.
# demo.py runs on synthetic data and needs none of this. Never commit a filled-in .env.

# REST services
GPS_API_BASE=http://localhost:8080
DEVICE_API_BASE=http://localhost:8081
FASTAG_API_BASE=http://localhost:8082
DOC_STORE_API_BASE=http://localhost:8083
VISION_API_BASE=http://localhost:8084
GOOGLE_SHEET_URL=

# SQL (SQLAlchemy URLs)
ANALYTICS_DB_URL=postgresql://user:password@localhost:5432/analytics
DATALAKE_DB_URL=postgresql://user:password@localhost:5439/datalake
FLEET_DB_URL=mysql+pymysql://user:password@localhost:3306/fleet
USERS_DB_URL=mysql+pymysql://user:password@localhost:3306/users_db

# Mongo
TELEMATICS_MONGO_URI=mongodb://user:password@localhost:27017/telematics_db
ANALYTICS_MONGO_URI=mongodb://user:password@localhost:27017/analytics_db
APP_MONGO_URI=

# Used inside a few notebook cells
DB_USER=
DB_PASSWORD=
SMTP_PASSWORD=

# OCR (kyc-document-ocr): tesseract | google
OCR_ENGINE=tesseract
GOOGLE_APPLICATION_CREDENTIALS=

# Device health Lambda (aws_lambda/)
PING_SOURCE=http
HEALTH_DB_URL=
DEVICE_HEALTH_LAMBDA_URL=
MAX_WORKERS=10
